<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.scan_engine">
    <uses-permission android:name="android.permission.INTERNET"/>
    <permission
        android:name="com.example.scan_engine.permission.ACCESS_MARKET_SCAN"
        android:protectionLevel="dangerous" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CryptoTest">

        <service android:name=".service.MarketScanService"
            android:permission="com.example.scan_engine.permission.ACCESS_MARKET_SCAN"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.scanner_api.MARKET_SCAN_SERVICE"/>
            </intent-filter>
        </service>

    </application>

</manifest>